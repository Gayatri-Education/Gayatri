              "name": "The Enlightenment and Social Contract Theory",
              "description": "Philosophical principles of Locke, Rousseau, Montesquieu; rationalism, individual liberty, and governance",
              "difficulty": 0.5,
              "prerequisites": [],
              "keywords": ["enlightenment", "social contract", "locke", "rousseau", "montesquieu", "liberty", "rationalism"],
              "aliases": ["age of reason", "enlightenment philosophy"],
