              "prerequisites": ["hist_enlightenment"],
              "keywords": ["industrial revolution", "steam power", "factory system", "urbanization", "mechanization"],
              "aliases": ["first industrial revolution", "industrialization"],
              "domain": "Modern History",
              "chapter": "The Industrial Age"
