              "domain": "Classical Antiquity",
              "chapter": "The Roman World"
            },
            {
              "id": "hist_roman_empire",
              "name": "The Roman Empire & Pax Romana",
              "description": "Transition from republic to principate under Augustus, imperial administration, and provincial integration",
              "difficulty": 0.5,
              "prerequisites": ["hist_roman_republic"],
              "keywords": ["roman empire", "augustus", "principate", "pax romana", "caesar"],
              "aliases": ["imperial rome", "the principate"],
              "domain": "Classical Antiquity",
              "chapter": "The Roman World"
            }
          ]
        }
      ]
    },
    {
      "id": "hist_mod_modern",
      "name": "The Modern World and Global Revolutions",
      "sequence_order": 2,
      "topics": [
        {
          "id": "hist_top_transformations",
