              "name": "The Fertile Crescent & Agricultural Revolution",
              "description": "Transition from foraging to agrarian settlements along the Tigris and Euphrates rivers",
              "difficulty": 0.2,
              "prerequisites": [],
              "keywords": ["fertile crescent", "mesopotamia", "agriculture", "neolithic revolution", "sumer"],
              "aliases": ["neolithic transition", "rise of agriculture"],
