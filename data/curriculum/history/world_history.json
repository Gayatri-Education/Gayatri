              "description": "Senate, magistrates, tribunes of the plebs, checks and balances, and civic expansion",
              "difficulty": 0.4,
              "prerequisites": ["hist_hammurabi_code"],
              "keywords": ["roman republic", "senate", "consuls", "patricians", "plebeians", "twelve tables"],
