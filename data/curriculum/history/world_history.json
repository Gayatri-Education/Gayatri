{
  "subject": "History",
  "course_id": "world_history_intro",
  "version": "1.0",
  "title": "Survey of World History: Ancient to Modern Era",
  "description": "Comprehensive historical analysis of ancient civilizations, state formations, revolutions, and modern transformations",
