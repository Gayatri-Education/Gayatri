              "prerequisites": ["hist_fertile_crescent"],
              "keywords": ["hammurabi", "babylon", "legal code", "codified law", "lex talionis", "cuneiform"],
              "aliases": ["hammurabi's code", "ancient babylonian law"],
              "domain": "Ancient History",
              "chapter": "Early Empires"
            }
          ]
        },
        {
          "id": "hist_top_mediterranean",
          "name": "Classical Mediterranean Antiquity",
          "sequence_order": 2,
          "concepts": [
            {
              "id": "hist_roman_republic",
